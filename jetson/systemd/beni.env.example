# /etc/beni/beni.env (mode 0600, owner beni)
BENI_TOKEN=change-me
# Cloudflare Worker WebSocket Relay (100% free, permanent URL; replaces tailscale):
BENI_BRAIN_URL=wss://beni-relay.impjrimpjr.workers.dev/robot
# Or local stub on dev PC: BENI_BRAIN_URL=ws://<pc-ip>:8765/ws
BENI_DB=/ssd/beni/memory.db
BENI_MODELS=/ssd/beni/models
KAGGLE_KERNEL=youruser/beni-brain
KAGGLE_CONFIG_DIR=/home/beni/.kaggle
HF_TOKEN=
HF_BACKUP_REPO=youruser/beni-memory
# Optional overrides (defaults in beni_agent/config.py)
# BENI_BRAIN_URLS=ws://beni-brain:8765/ws,wss://beni-brain.example.com/ws
# BENI_DETECTOR=yolo26n        # yolo26n | yolov8n (§6.4.3 bake-off result; both vision services)
# BENI_UPLINK=pcm16            # pcm16 | opus
# BENI_AWAKE_HOURS=07:00-12:00,16:00-22:30
# BENI_WEEKLY_BUDGET_H=28
# BENI_QUIET_HOURS=22:00-07:00
# BENI_HOME_CITY=Colombo
# BENI_GPIO_ESTOP=14           # sysfs number of header pin 13 (ESP32 e-stop out); -1 disables
# BENI_GPIO_MUTE=194           # mic-mute button to GND on pin 15 (external 10k pull-up to 3V3)
# BENI_PHONES=Nimal=AA:BB:CC:DD:EE:FF   # paired phones for "owner is home" (bluetoothctl pair, then trust)
# BENI_TOUCH=auto               # auto (USB evdev, else SPI1 XPT2046) | off | /dev/input/eventN
# BENI_GPIO_PENIRQ=13           # XPT2046 PENIRQ on header pin 22 (else 10 Hz polling)
# BENI_TOUCH_CAL=200,3900,200,3900
