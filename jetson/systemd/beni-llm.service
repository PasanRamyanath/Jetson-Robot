[Unit]
Description=Beni offline LLM (llama.cpp Qwen2.5-0.5B Q4_K_M), started on demand by the agent
[Service]
User=beni
ExecStart=/opt/beni/jetson/llm/llama.cpp/build/bin/llama-server -m /ssd/beni/models/qwen2.5-0.5b-instruct-q4_k_m.gguf \
  --host 127.0.0.1 --port 8081 -c 2048 -t 2 -tb 2 --mlock
CPUAffinity=2 3
Nice=10
OOMScoreAdjust=1000
MemoryLimit=700M
Restart=on-failure
