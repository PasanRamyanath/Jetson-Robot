<?xml version="1.0" encoding="UTF-8"?>
<!-- §7.3: loopback only, no multicast, small buffers. Everything talks inside one host (and mostly one process). -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces><NetworkInterface name="lo"/></Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>32</MaxAutoParticipantIndex>
      <Peers><Peer address="localhost"/></Peers>
    </Discovery>
    <Internal><SocketReceiveBufferSize min="1MB"/></Internal>
  </Domain>
</CycloneDDS>
